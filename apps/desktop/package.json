{
  "name": "@gather/desktop",
  "version": "0.1.0-phase.0",
  "private": true,
  "description": "Gather desktop workspace",
  "author": "Gather contributors",
  "license": "AGPL-3.0-only",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "stage": "electron-vite build && node scripts/stage-portable.mjs",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "dependencies": {
    "@gather/core": "0.1.0-phase.0",
    "@gather/editor": "0.1.0-phase.0",
    "lucide-react": "^1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "scheduler": "^0.28.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "38.8.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.gather.editor",
    "productName": "Gather",
    "copyright": "Copyright © 2026 Gather contributors",
    "electronVersion": "38.8.6",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "compression": "normal"
    },
    "nsis": {
      "artifactName": "Gather-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gather",
      "uninstallDisplayName": "Gather",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "synopsis": "Local-first Markdown writing workspace",
      "description": "Gather is a local-first Markdown writing workspace with file safety, recovery, reading modes and first-class CLI.",
      "executableName": "gather",
      "syncDesktopName": true,
      "maintainer": "Gather contributors <hhxpoint@users.noreply.github.com>"
    },
    "deb": {
      "packageName": "gather"
    }
  },
  "homepage": "https://hhxpoint.github.io/gather/",
  "repository": {
    "type": "git",
    "url": "https://github.com/hhxpoint/gather.git"
  },
  "desktopName": "gather.desktop"
}
